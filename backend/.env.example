DEEPSEEK_API_KEY=在这里填你的 key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
CHAOXI_DB=chaoxi.db

# 嵌入模型：走镜像、禁用 Xet（hf-mirror 不代理 Xet，不禁会 401）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
# 模型缓存别放系统 Temp（会被清理）。Windows 写 D:/fastembed-cache，容器里写 /data/fastembed-cache
FASTEMBED_CACHE_PATH=D:/fastembed-cache